{"author":"LlvallVeiz","bin":{"solar":"./bin/solar.js"},"description":"Off-grid solar PV sizing tool: daily load profiles, panel / battery / controller / inverter sizing, tilt optimisation, monthly PSH variation and sensitivity analysis — pure Node.js, zero runtime dependencies.","engines":{"node":">=18"},"keywords":["solar","photovoltaic","pv","sizing","off-grid","battery","peak-sun-hours","psh","nasa-power","energy"],"license":"MIT","main":"src/index.js","name":"solar-sizing-tool","scripts":{"example:check":"node bin/solar.js check --preset rumah-kecil --location jakarta --panels 2 --panel-w 550 --battery-kwh 7.68","example:home":"node bin/solar.js size --preset rumah-kecil --location jakarta","example:iot":"node bin/solar.js size --preset iot-offgrid --location denpasar","example:monthly":"node bin/solar.js monthly --preset rumah-menengah --location jakarta","example:office":"node bin/solar.js size --preset kantor-kecil --location surabaya","example:sensitivity":"node bin/solar.js sensitivity --preset rumah-kecil --location jakarta","example:tilt":"node bin/solar.js tilt --location jakarta","start":"node bin/solar.js","test":"node --test tests/*.test.js"},"type":"commonjs","version":"1.0.0"}